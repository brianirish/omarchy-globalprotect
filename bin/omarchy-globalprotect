#!/usr/bin/env python3
"""omarchy-globalprotect: GlobalProtect (SAML / Google SSO) for Omarchy.

NetworkManager owns the tunnel. This tool does the unprivileged parts:
portal prelogin, a WebKit sign-in window, `openconnect --authenticate`,
and handing the resulting session to `nmcli connection up`.
"""
import argparse
import base64
import datetime
import io
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import tarfile
import time
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path

APP = "omarchy-globalprotect"
NM_CONNECTION = "GlobalProtect"
CLIENT_OS = {"win": "Windows", "linux": "Linux", "mac": "Mac"}
COOKIE_KINDS = ("prelogin-cookie", "portal-userauthcookie")
SAML_FIELDS = COOKIE_KINDS + ("saml-username", "saml-auth-status")
HIP_SCRIPTS = ("/usr/lib/openconnect/hipreport.sh", "/usr/libexec/openconnect/hipreport.sh")
AUTH_INTERFACES = ("auto", "portal", "gateway")
# Some deployments require SAML at the gateway as well as (or instead of) the portal;
# "auto" probes the gateway interface on the configured host first, then the portal.
PRELOGIN_PATHS = {"portal": "global-protect/prelogin.esp", "gateway": "ssl-vpn/prelogin.esp"}
ESP_PORT = 4501  # GlobalProtect ESP-over-UDP; the HTTPS tunnel fallback uses 443
DEBUG_LOG_MAX = 1024 * 1024
BUNDLE_DIR = "omarchy-globalprotect-logs"
OS_VERSIONS = {"Windows": "Microsoft Windows 10 Pro, 64-bit", "Linux": "Linux", "Mac": "Apple Mac OS X 13.0.0"}


class PreloginError(Exception):
    pass


class AuthError(Exception):
    pass


class Cancelled(Exception):
    pass


class HipError(Exception):
    pass


class PortalConfigError(Exception):
    pass


# --------------------------------------------------------------------------- pure helpers

def parse_prelogin(xml_text):
    """Turn the portal's prelogin.esp XML into {"method": POST|REDIRECT, "request": str}."""
    try:
        root = ET.fromstring(xml_text)
    except ET.ParseError as e:
        raise PreloginError(f"Portal returned unreadable prelogin XML ({e})")
    status = (root.findtext("status") or "").strip()
    if status.lower() == "error":
        raise PreloginError((root.findtext("msg") or "Portal rejected prelogin").strip())
    method = (root.findtext("saml-auth-method") or "").strip().upper()
    request = (root.findtext("saml-request") or "").strip()
    if method in ("POST", "REDIRECT") and request:
        try:
            decoded = base64.b64decode(request).decode("utf-8", "replace")
        except (ValueError, TypeError) as e:
            raise PreloginError(f"Portal sent an undecodable SAML request ({e})")
        return {"method": method, "request": decoded,
                "defaultBrowser": (root.findtext("saml-default-browser") or "").strip().lower() == "yes"}
    if method or request:
        raise PreloginError("Portal sent an unusable SAML prelogin (method or request missing)")
    # No SAML: the portal wants a username and password (LDAP/RADIUS/local), possibly with a challenge later.
    return {
        "method": "PASSWORD",
        "usernameLabel": (root.findtext("username-label") or "").strip() or "Username",
        "passwordLabel": (root.findtext("password-label") or "").strip() or "Password",
        "message": (root.findtext("authentication-message") or "").strip(),
        "region": (root.findtext("region") or "").strip(),
    }


_COMMENT_RE = re.compile(r"<!--(.*?)-->", re.S)
_TAG_RE = re.compile(r"<(saml-username|saml-auth-status|prelogin-cookie|portal-userauthcookie)>(.*?)</\1>", re.S)


def extract_saml_result(headers, html):
    """Collect SAML completion fields from HTTP headers and/or HTML comments. Headers win."""
    out = {}
    for name, value in (headers or {}).items():
        key = str(name).lower()
        if key in SAML_FIELDS and value:
            out[key] = str(value).strip()
    for comment in _COMMENT_RE.findall(html or ""):
        for key, value in _TAG_RE.findall(comment):
            if value.strip():
                out.setdefault(key, value.strip())
    return out


def saml_result_complete(result):
    return bool(result.get("saml-username")) and any(result.get(k) for k in COOKIE_KINDS)


def choose_cookie(result):
    for kind in COOKIE_KINDS:
        if result.get(kind):
            return kind, result[kind]
    raise AuthError("SAML login finished without a cookie")


def parse_authenticate_output(text):
    """Parse the KEY='value' lines printed by `openconnect --authenticate`."""
    out = {}
    for line in text.splitlines():
        m = re.match(r"^(COOKIE|HOST|CONNECT_URL|FINGERPRINT|RESOLVE)=(.*)$", line.strip())
        if not m:
            continue
        raw = m.group(2)
        try:
            parts = shlex.split(raw) if raw else [""]
        except ValueError:
            parts = [raw]
        out[m.group(1)] = parts[0] if parts else ""
    return out


def render_passwd_file(auth):
    lines = [
        f"vpn.secrets.cookie:{auth['COOKIE']}",
        f"vpn.secrets.gateway:{auth['CONNECT_URL']}",
        f"vpn.secrets.gwcert:{auth['FINGERPRINT']}",
    ]
    if auth.get("RESOLVE"):
        lines.append(f"vpn.secrets.resolve:{auth['RESOLVE']}")
    return "\n".join(lines) + "\n"


def build_vpn_data(portal, hip, hip_script, proxy="", certificate="", key="", ssl_only=False, mtu=0):
    data = (
        f"gateway={portal},protocol=gp,authtype=password,cookie-flags=2,gateway-flags=2,"
        f"gwcert-flags=2,resolve-flags=2,enable_csd_trojan={'yes' if hip else 'no'}"
    )
    if hip and hip_script:
        data += f",csd_wrapper={hip_script}"
    if proxy:
        data += f",proxy={proxy}"
    if certificate:
        data += f",usercert={certificate}"
    if key:
        data += f",privkey={key}"
    if ssl_only:
        data += ",disable_udp=yes"
    if mtu and int(mtu) > 0:
        data += f",mtu={int(mtu)}"
    return data


def parse_nmcli_terse(text):
    """Parse `nmcli -t` KEY:value lines, honouring the `\\:` escape."""
    out = {}
    for line in text.splitlines():
        m = re.match(r"^((?:[^:\\]|\\.)+):(.*)$", line)
        if not m:
            continue
        out[m.group(1).replace("\\:", ":")] = m.group(2).replace("\\:", ":")
    return out


_SS_PEER_RE = re.compile(r"^\[?([^\]\s]+?)\]?:(\d+)$")


def parse_ss_peers(text):
    """(proto, peer_ip, peer_port) for every ESTAB socket in `ss -tunH` output."""
    peers = []
    for line in (text or "").splitlines():
        f = line.split()
        if len(f) < 6 or f[1] != "ESTAB":
            continue
        m = _SS_PEER_RE.match(f[5])
        if m:
            peers.append((f[0], m.group(1), int(m.group(2))))
    return peers


def detect_protocol(peers, gateway_ip):
    """"esp" (IPSec over UDP), "ssl" (HTTPS tunnel), or "" when neither is visible."""
    if gateway_ip:
        if ("udp", gateway_ip, ESP_PORT) in peers:
            return "esp"
        if ("tcp", gateway_ip, 443) in peers:
            return "ssl"
        return ""
    return "esp" if any(p[0] == "udp" and p[2] == ESP_PORT for p in peers) else ""


def nm_list(details, prefix):
    """Values of nmcli's indexed fields (IP4.DNS[1], IP4.DNS[2], ...) in index order."""
    pat = re.compile(r"^" + re.escape(prefix) + r"\[(\d+)\]$")
    items = []
    for key, value in details.items():
        m = pat.match(key)
        if m and value:
            items.append((int(m.group(1)), value))
    return [v for _, v in sorted(items)]


def nm_routes(details):
    out = []
    for entry in nm_list(details, "IP4.ROUTE"):
        m = re.search(r"dst = ([^,\s]+)", entry)
        if m:
            out.append(m.group(1))
    return out


def is_full_tunnel(routes):
    return any(r in ("0.0.0.0/0", "::/0") for r in routes)


_SECRET_KV_RE = re.compile(r"(?i)((?:prelogin-cookie|portal-userauthcookie|authcookie|vpn\.secrets\.cookie|passwd|password)\s*[=:]\s*['\"]?)([^'\"&\s]+)")
_SECRET_XML_RE = re.compile(r"(?i)(<(prelogin-cookie|portal-userauthcookie)>)([^<]+)")


def scrub_secrets(text):
    """Mask session cookies and passwords in any text that leaves the machine (log bundles)."""
    text = _SECRET_XML_RE.sub(r"\1<redacted>", text or "")
    return _SECRET_KV_RE.sub(r"\1<redacted>", text)


def bundle_path(base_dir, when):
    return Path(base_dir) / f"{BUNDLE_DIR}-{when:%Y%m%d-%H%M%S}.tar.gz"


def write_bundle(path, members):
    """Write a 0600 tar.gz whose members are {name: text} under a single top-level directory."""
    path = Path(path)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as f, tarfile.open(fileobj=f, mode="w:gz") as tar:
        for name, content in members.items():
            data = content.encode("utf-8", "replace") if isinstance(content, str) else bytes(content)
            info = tarfile.TarInfo(f"{BUNDLE_DIR}/{name}")
            info.size = len(data)
            info.mtime = int(time.time())
            info.mode = 0o600
            tar.addfile(info, io.BytesIO(data))
    path.chmod(0o600)


OPTS = {"proxy": "", "certificate": "", "key": "", "browser": False, "fresh": False,
        "ssl_only": False, "mtu": 0, "block_lan": False, "dns_mode": "auto"}


def set_options(args):
    """Per-invocation options every network step consults (proxy, client certificate, browser mode)."""
    OPTS.update(
        proxy=(getattr(args, "proxy", "") or "").strip(),
        certificate=(getattr(args, "certificate", "") or "").strip(),
        key=(getattr(args, "key", "") or "").strip(),
        browser=bool(getattr(args, "browser", False)),
        fresh=bool(getattr(args, "fresh", False)),
        ssl_only=bool(getattr(args, "ssl_only", False)),
        mtu=max(0, int(getattr(args, "mtu", 0) or 0)),
        block_lan=bool(getattr(args, "block_lan", False)),
        dns_mode=str(getattr(args, "dns_mode", "auto") or "auto"),
    )


def prompt_pending(text):
    """The prompt openconnect is waiting on ("Password:", "Response:"), or "" when the output ends with a newline."""
    tail = (text or "").rsplit("\n", 1)[-1]
    m = re.match(r"^\s*(.*?\S):\s*$", tail)
    return f"{m.group(1)}:" if m else ""


CALLBACK_SCHEME = "globalprotectcallback:"


def parse_callback_uri(uri):
    """The system-browser flow's return trip: CAS (un + token) or a base64 HTML page with the SAML comments."""
    text = str(uri or "").strip()
    if not text.lower().startswith(CALLBACK_SCHEME):
        raise AuthError("Not a GlobalProtect sign-in callback")
    payload = text[len(CALLBACK_SCHEME):]
    if "cas-as" in payload:
        q = urllib.parse.parse_qs(payload)
        if "un" not in q or "token" not in q:
            q = urllib.parse.parse_qs(urllib.parse.unquote(payload))
        username, token = q.get("un", [""])[0], q.get("token", [""])[0]
        if not username or not token:
            raise AuthError("The sign-in callback is missing the user or token")
        return {"username": username, "token": token}
    try:
        html = base64.b64decode(payload + "=" * (-len(payload) % 4)).decode("utf-8", "replace")
    except (ValueError, TypeError):
        raise AuthError("The sign-in callback could not be decoded")
    result = extract_saml_result({}, html)
    token = result.get("prelogin-cookie") or result.get("portal-userauthcookie")
    if not result.get("saml-username") or not token:
        raise AuthError("The sign-in callback carried no session")
    return {"username": result["saml-username"], "token": token}


VIRTUAL_DEV_PREFIXES = ("lo", "vpn", "tun", "tap", "wg", "docker", "virbr", "br-", "veth", "podman", "cni", "flannel", "tailscale")


def lan_subnets(routes, tunnel_iface):
    """Kernel-added on-link subnets of physical devices, from `ip -j route`; what "no local network" must block."""
    out = []
    for r in routes or []:
        dst, dev = str(r.get("dst", "")), str(r.get("dev", ""))
        if r.get("protocol") != "kernel" or r.get("scope") != "link" or "/" not in dst:
            continue
        if not dev or dev == tunnel_iface or dev.startswith(VIRTUAL_DEV_PREFIXES):
            continue
        if dst.endswith("/32") or dst.endswith("/128"):
            continue
        if dst not in out:
            out.append(dst)
    return out


def parse_resolvectl_link(text):
    """What systemd-resolved actually uses on a link (`resolvectl status <link>`)."""
    dns, domains, active, default_route = [], [], False, False
    for line in (text or "").splitlines():
        key, _, value = line.strip().partition(":")
        key, value = key.strip(), value.strip()
        if key == "Current Scopes":
            active = value != "none" and value != ""
        elif key == "DNS Servers":
            dns = value.split()
        elif key == "DNS Domain":
            domains = value.split()
        elif key == "Protocols" and "+DefaultRoute" in value:
            default_route = True
        elif key == "Default Route" and value.lower() == "yes":
            default_route = True
    return {"dns": dns, "domains": domains, "active": active, "defaultRoute": default_route}


SPLIT_DNS_RULE_FILE = "50-omarchy-globalprotect-resolved.rules"


def split_dns_rule():
    """polkit rule: let local wheel users set the tunnel link's DNS in systemd-resolved (no prompt)."""
    return (
        "// Installed by omarchy-globalprotect. Lets users in wheel, in a local session, point the\n"
        "// GlobalProtect tunnel's DNS at what the gateway pushed (split DNS) without a password prompt.\n"
        "polkit.addRule(function(action, subject) {\n"
        "  if ((action.id == \"org.freedesktop.resolve1.set-dns-servers\" ||\n"
        "       action.id == \"org.freedesktop.resolve1.set-domains\" ||\n"
        "       action.id == \"org.freedesktop.resolve1.set-default-route\" ||\n"
        "       action.id == \"org.freedesktop.resolve1.revert\") &&\n"
        "      subject.isInGroup(\"wheel\") && subject.local) {\n"
        "    return polkit.Result.YES;\n"
        "  }\n"
        "});\n"
    )


def split_dns_state(conf_dir=Path("/etc/NetworkManager/conf.d"), rules_dir=Path("/etc/polkit-1/rules.d")):
    """not-needed: no global DNS override; needed: override present, rule missing; enabled: rule installed."""
    if (Path(rules_dir) / SPLIT_DNS_RULE_FILE).exists():
        return "enabled"
    try:
        for f in sorted(Path(conf_dir).glob("*.conf")):
            if "[global-dns" in f.read_text(errors="replace"):
                return "needed"
    except OSError:
        pass
    return "not-needed"


def split_dns_plan(iface, dns, domains, full_tunnel, mode):
    """resolvectl calls that make the tunnel's DNS answer for its domains (or everything on a full tunnel in auto)."""
    if mode == "off" or not dns or not iface:
        return []
    if domains:
        return [["resolvectl", "dns", iface, *dns],
                ["resolvectl", "domain", iface, *[f"~{d.lstrip('~')}" for d in domains]],
                ["resolvectl", "default-route", iface, "no"]]
    if full_tunnel and mode == "auto":
        return [["resolvectl", "dns", iface, *dns],
                ["resolvectl", "domain", iface, "~."],
                ["resolvectl", "default-route", iface, "yes"]]
    return []


def global_ip6(details):
    for entry in nm_list(details, "IP6.ADDRESS"):
        addr = entry.split("/")[0]
        if addr and not addr.lower().startswith("fe80"):
            return addr
    return ""


_JOURNAL_MSG_RE = re.compile(r"^(\S+)\s+\S+\s+\S+?\[\d+\]:\s*(.*)$")


def parse_hip_journal(text):
    """Last HIP check / submission / warning from openconnect's journal lines (short-iso format)."""
    out = {"lastCheck": "", "lastSubmit": "", "warning": "", "warningAt": ""}
    for line in (text or "").splitlines():
        m = _JOURNAL_MSG_RE.match(line.strip())
        if not m:
            continue
        ts, msg = m.group(1), m.group(2)
        low = msg.lower()
        if "hipreportcheck" in low or "hip check due" in low:
            out["lastCheck"] = ts
        elif "hip report submitted" in low or "submitting hip report" in low:
            out["lastSubmit"] = ts
        if ("hip" in low or "csd" in low) and any(w in low for w in ("fail", "not compliant", "remediat", "reject", "denied")):
            out["warning"], out["warningAt"] = msg, ts
    return out


def hip_journal_status(since="-1 day"):
    try:
        r = run(["journalctl", "-t", "openconnect", "-u", "NetworkManager", "--since", since, "-o", "short-iso", "--no-pager", "-n", "2000"], timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return parse_hip_journal("")
    return parse_hip_journal(r.stdout if r.returncode == 0 else "")


def gateway_host(name):
    """The host part of a portal gateway entry name ("gw.example.com:443" -> "gw.example.com")."""
    return re.sub(r":\d+$", "", str(name or "").strip())


def parse_portal_config(xml_text):
    """The parts of the portal's getconfig.esp policy we use: gateways, cookie, HIP interval."""
    try:
        root = ET.fromstring(xml_text)
    except ET.ParseError as e:
        raise PortalConfigError(f"Portal config is not valid XML ({e})")
    if (root.findtext("status") or "").strip().lower() == "error":
        raise PortalConfigError((root.findtext("msg") or "Portal rejected the config request").strip())
    gateways = []
    for entry in root.findall("./gateways/external/list/entry"):
        name = (entry.get("name") or "").strip()
        if not name:
            continue
        prio = (entry.findtext("priority") or "").strip()
        if not prio:
            rules = entry.findall("./priority-rule/entry")
            anyrule = [r for r in rules if (r.get("name") or "").strip().lower() in ("any", "")]
            pick = (anyrule or rules)[:1]
            if pick:
                prio = (pick[0].findtext("priority") or "").strip()
        try:
            priority = int(prio)
        except ValueError:
            priority = 0
        gateways.append({
            "name": name,
            "host": gateway_host(name),
            "description": (entry.findtext("description") or "").strip() or gateway_host(name),
            "priority": priority,
            "manual": (entry.findtext("manual") or "").strip().lower() == "yes",
        })
    try:
        hip_interval = int((root.findtext("./hip-collection/hip-report-interval") or "0").strip() or 0)
    except ValueError:
        hip_interval = 0
    return {
        "gateways": gateways,
        "portalUserAuthCookie": (root.findtext("portal-userauthcookie") or "").strip(),
        "portalName": (root.findtext("portal-name") or "").strip(),
        "hipInterval": hip_interval,
        "policy": parse_portal_policy(root),
    }


def _yes(text, default=False):
    v = (text or "").strip().lower()
    if v in ("yes", "1", "true"):
        return True
    if v in ("no", "0", "false"):
        return False
    return default


def _int(text, default=0):
    try:
        return int((text or "").strip())
    except ValueError:
        return default


def parse_portal_policy(root):
    """The portal-driven app settings we honour (the official client's agent-config)."""
    ac = root.find("agent-config")
    ui = root.find("agent-ui")
    ac_text = (lambda tag: ac.findtext(tag) if ac is not None else None)
    ui_text = (lambda tag: ui.findtext(tag) if ui is not None else None)
    welcome = ""
    wp = ui.find("welcome-page") if ui is not None else None
    if wp is not None and _yes(wp.findtext("display")):
        welcome = (wp.findtext("page") or "").strip()
    return {
        "portalName": (root.findtext("portal-name") or "").strip(),
        "version": (root.findtext("version") or "").strip(),
        "configDigest": (root.findtext("config-digest") or "").strip(),
        "connectMethod": (root.findtext("connect-method") or "").strip(),
        "refreshConfigInterval": _int(root.findtext("refresh-config-interval"), 0) if _yes(root.findtext("refresh-config"), True) else 0,
        "hipInterval": _int(root.findtext("./hip-collection/hip-report-interval"), 0),
        "tunnelMtu": _int(ac_text("tunnel-mtu"), 0),
        "sslOnly": _yes(ac_text("ssl-only-selection")),
        "rediscoverNetwork": _yes(ac_text("rediscover-network"), True),
        "enableSignout": _yes(ac_text("enable-signout"), True),
        "defaultBrowser": _yes(ac_text("default-browser")),
        "retryTunnel": _int(ac_text("retry-tunnel"), 0),
        "retryTimeout": _int(ac_text("retry-timeout"), 0),
        "captivePortalNotificationDelay": _int(ac_text("captive-portal-notification-delay"), 5),
        "saveUserCredentials": _yes(ac_text("save-user-credentials")),
        "canSavePassword": _yes(ui_text("can-save-password"), True),
        "canChangePortal": _yes(ui_text("can-change-portal"), True),
        "welcomePage": welcome,
    }


def portal_config_body(portal, username, prelogin_cookie, client_os, hostname, password="", userauthcookie=""):
    """The getconfig.esp form openconnect sends: user + prelogin-cookie after SAML, user + passwd, or the portal cookie."""
    os_name = CLIENT_OS.get(client_os, "Windows")
    fields = [
        ("jnlpReady", "jnlpReady"), ("ok", "Login"), ("direct", "yes"), ("clientVer", "4100"), ("prot", "https:"),
        ("internal", "no"), ("ipv6-support", "yes"), ("clientos", os_name), ("os-version", OS_VERSIONS[os_name]),
        ("server", portal), ("computer", hostname), ("user", username),
    ]
    if userauthcookie:
        fields.append(("portal-userauthcookie", userauthcookie))
    elif password:
        fields.append(("passwd", password))
    else:
        fields.append(("prelogin-cookie", prelogin_cookie))
    return urllib.parse.urlencode(fields)


def best_gateway(gateways, latencies):
    """The official client's Best Available: highest priority first, then lowest TLS latency. Manual-only gateways are skipped."""
    big = 10 ** 9
    candidates = [g for g in gateways if not g.get("manual")]
    if not candidates:
        return ""

    def key(g):
        prio = int(g.get("priority") or 0)
        lat = latencies.get(g.get("host", ""), latencies.get(g.get("name", "")))
        lat_ok = isinstance(lat, (int, float)) and lat >= 0
        return (prio if prio > 0 else big, lat if lat_ok else big, g.get("name", ""))

    return min(candidates, key=key)["name"]


def signin_host(portal, interface, gateway_name):
    """Where the SAML sign-in happens: the chosen gateway for the gateway interface, else the portal."""
    return gateway_host(gateway_name) if interface == "gateway" and gateway_name else portal


def resolve_gateway_choice(setting, state):
    """An explicit gateway setting wins; empty means Best Available from the cached list."""
    if setting:
        return setting
    return best_gateway(state.get("gateways") or [], state.get("latencies") or {})


def parse_hip_report(xml_text):
    """Flatten a HIP report (what hipreport.sh prints) into the fields worth showing."""
    try:
        root = ET.fromstring(xml_text)
    except ET.ParseError as e:
        raise HipError(f"HIP report is not valid XML ({e})")
    host = None
    categories, products = [], []
    for entry in root.findall("./categories/entry"):
        name = (entry.get("name") or "").strip()
        if name:
            categories.append(name)
        if name == "host-info":
            host = entry
        for prod in entry.iter("Prod"):
            n = (prod.get("name") or "").strip()
            if n and n not in products:
                products.append(n)

    def text(el, tag):
        return (el.findtext(tag) or "").strip() if el is not None else ""

    return {
        "os": text(host, "os"),
        "osVendor": text(host, "os-vendor"),
        "clientVersion": text(host, "client-version"),
        "hostName": text(root, "host-name") or text(host, "host-name"),
        "hostId": text(root, "host-id") or text(host, "host-id"),
        "ipAddress": text(root, "ip-address"),
        "categories": categories,
        "products": products,
    }


def hip_report_command(script, username, hostname, ip, client_os):
    """Run hipreport.sh the way openconnect does, with placeholders for the session-bound bits."""
    cookie = f"user={username}&domain=&computer={hostname}"
    return [script, "--cookie", cookie, "--client-ip", ip or "0.0.0.0", "--md5", "0" * 32,
            "--client-os", CLIENT_OS.get(client_os, "Windows")]


CONNECTIVITY = ("full", "limited", "portal", "none")


def parse_connectivity(text):
    """nmcli's connectivity word normalized: full | limited | portal | none | unknown."""
    v = (text or "").strip().lower()
    return v if v in CONNECTIVITY else "unknown"


def derive_state(conn_state, runfile, portal, deps):
    if not portal:
        return "unconfigured"
    if not all(deps.get(k) for k in ("openconnect", "nmOpenconnect", "webkit")):
        return "missing-deps"
    if conn_state == "activated":
        return "connected"
    if runfile and runfile.get("alive"):
        return "activating" if runfile.get("phase") == "activating" else "authenticating"
    if conn_state == "activating":
        return "activating"
    return "disconnected"


# --------------------------------------------------------------------------- filesystem state

def _xdg(var, default):
    return Path(os.environ.get(var) or default)


def _private_dir(path):
    path.mkdir(parents=True, exist_ok=True)
    try:
        path.chmod(0o700)
    except OSError:
        pass
    return path


def runtime_dir():
    return _private_dir(_xdg("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}") / APP)


def state_dir():
    return _private_dir(_xdg("XDG_STATE_HOME", Path.home() / ".local/state") / APP)


def data_dir():
    return _private_dir(_xdg("XDG_DATA_HOME", Path.home() / ".local/share") / APP)


def write_runfile(phase, pid=None):
    (runtime_dir() / "connect.json").write_text(json.dumps({"pid": pid or os.getpid(), "phase": phase, "at": time.time()}))


def clear_runfile():
    try:
        (runtime_dir() / "connect.json").unlink()
    except FileNotFoundError:
        pass


def read_runfile():
    try:
        d = json.loads((runtime_dir() / "connect.json").read_text())
    except (FileNotFoundError, ValueError):
        return None
    try:
        os.kill(int(d.get("pid", 0)), 0)
        d["alive"] = True
    except (OSError, ValueError):
        d["alive"] = False
    return d


_DEBUG = False


def set_debug(on):
    global _DEBUG
    _DEBUG = bool(on)


def debug_log(msg):
    """Append one timestamped line to the debug log when --debug is on. Never pass secrets."""
    if not _DEBUG:
        return
    try:
        path = state_dir() / "debug.log"
        if path.exists() and path.stat().st_size > DEBUG_LOG_MAX:
            path.replace(path.with_name("debug.log.1"))
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(f"{datetime.datetime.now().isoformat(timespec='seconds')} {msg}\n")
    except OSError:
        pass


def _read_json(path):
    try:
        return json.loads(Path(path).read_text())
    except (FileNotFoundError, ValueError):
        return {}


def _write_json(path, data):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(json.dumps(data))
    Path(path).chmod(0o600)


def _portal_state_path(portal):
    return _private_dir(state_dir() / "portals") / (str(portal).replace("/", "_") + ".json")


def load_state(portal=None):
    """Global state (the current portal) merged with that portal's own bucket.

    state.json keeps `portal` (and, for a fresh install, any pre-multi-portal keys); everything
    else lives in portals/<host>.json so switching portals keeps sessions and gateway lists apart.
    """
    base = _read_json(state_dir() / "state.json")
    current = portal or base.get("portal", "")
    if not current:
        return dict(base)
    bucket_path = _portal_state_path(current)
    bucket = _read_json(bucket_path)
    legacy = {k: v for k, v in base.items() if k != "portal"}
    if not bucket and legacy and current == base.get("portal", ""):
        # One-time migration from the flat layout.
        bucket = legacy
        _write_json(bucket_path, bucket)
    out = {"portal": base.get("portal", "")}
    out.update(bucket)
    return out


def save_state(**kv):
    """`portal` goes to state.json (and becomes current); other keys go to the portal's bucket."""
    kv = {k: v for k, v in kv.items() if v is not None}
    base = _read_json(state_dir() / "state.json")
    if "portal" in kv:
        base["portal"] = kv.pop("portal")
        _write_json(state_dir() / "state.json", base)
    current = base.get("portal", "")
    if not kv:
        return
    if not current:
        base.update(kv)
        _write_json(state_dir() / "state.json", base)
        return
    path = _portal_state_path(current)
    bucket = _read_json(path)
    bucket.update(kv)
    _write_json(path, bucket)


def known_portals():
    try:
        return sorted(p.stem for p in (state_dir() / "portals").glob("*.json"))
    except OSError:
        return []


def forget_portal(portal):
    try:
        _portal_state_path(portal).unlink()
    except FileNotFoundError:
        pass
    base = _read_json(state_dir() / "state.json")
    if base.get("portal") == portal:
        base["portal"] = ""
        _write_json(state_dir() / "state.json", base)


# --------------------------------------------------------------------------- system probes

def check_deps():
    return {
        "openconnect": shutil.which("openconnect") is not None,
        "nmOpenconnect": Path("/usr/lib/NetworkManager/VPN/nm-openconnect-service.name").exists(),
        "webkit": Path("/usr/lib/girepository-1.0/WebKit2-4.1.typelib").exists(),
    }


def run(cmd, timeout=15, input_text=None, check=False):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, input=input_text, check=check)


def nm_connection_state():
    """State of the GlobalProtect NM profile, "inactive" when present but down, None when no profile exists."""
    try:
        r = run(["nmcli", "-t", "-f", "NAME,STATE", "connection", "show"])
    except (OSError, subprocess.TimeoutExpired):
        return None
    for line in r.stdout.splitlines():
        name, _, state = line.rpartition(":")
        if name == NM_CONNECTION:
            return state or "inactive"
    return None


def nm_connectivity():
    try:
        r = run(["nmcli", "-t", "-f", "CONNECTIVITY", "general"], timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    return parse_connectivity(r.stdout) if r.returncode == 0 else "unknown"


def nm_connection_details():
    try:
        r = run(["nmcli", "-t", "connection", "show", NM_CONNECTION])
    except (OSError, subprocess.TimeoutExpired):
        return {}
    return parse_nmcli_terse(r.stdout) if r.returncode == 0 else {}


def iface_stats(iface):
    try:
        base = Path("/sys/class/net") / iface / "statistics"
        return int((base / "rx_bytes").read_text()), int((base / "tx_bytes").read_text())
    except (OSError, ValueError):
        return 0, 0


def find_iface_for_ip(ip):
    if not ip:
        return ""
    try:
        devs = json.loads(run(["ip", "-j", "addr"]).stdout)
    except Exception:
        return ""
    for dev in devs:
        for a in dev.get("addr_info", []):
            if a.get("local") == ip:
                return dev.get("ifname", "")
    return ""


def socket_peers():
    try:
        r = run(["ss", "-tunH"], timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return []
    return parse_ss_peers(r.stdout) if r.returncode == 0 else []


def resolve_host(host):
    """First IPv4 (else IPv6) address of host, "" when it does not resolve."""
    try:
        infos = socket.getaddrinfo(host, 443, proto=socket.IPPROTO_TCP)
    except (OSError, ValueError):
        return ""
    for family in (socket.AF_INET, socket.AF_INET6):
        for info in infos:
            if info[0] == family:
                return info[4][0]
    return ""


def fetch_portal_config(portal, username, prelogin_cookie, client_os, timeout=30, password="", userauthcookie=""):
    body = portal_config_body(portal, username, prelogin_cookie, client_os, socket.gethostname(),
                              password=password, userauthcookie=userauthcookie).encode()
    url = f"https://{portal}/global-protect/getconfig.esp"
    req = urllib.request.Request(url, data=body, method="POST",
                                 headers={"User-Agent": "PAN GlobalProtect", "Content-Type": "application/x-www-form-urlencoded"})
    debug_log(f"portal getconfig POST {url} user={username}")
    try:
        with http_opener().open(req, timeout=timeout) as resp:
            cfg = parse_portal_config(resp.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as e:
        raise PortalConfigError(f"Portal refused the config request (HTTP {e.code})")
    except (urllib.error.URLError, OSError) as e:
        raise PortalConfigError(f"Could not reach {portal}: {getattr(e, 'reason', e)}")
    debug_log(f"portal config: {len(cfg['gateways'])} gateways, portal-cookie={'yes' if cfg['portalUserAuthCookie'] else 'no'}, hip-interval={cfg['hipInterval']}")
    return cfg


def probe_latency(host, port=443, timeout=3.0):
    """TLS handshake time to host:port in ms, -1 when unreachable. Trust is openconnect's job (fingerprint pin)."""
    import ssl
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    start = time.monotonic()
    try:
        with socket.create_connection((host, port), timeout=timeout) as sock, ctx.wrap_socket(sock, server_hostname=host):
            return int((time.monotonic() - start) * 1000)
    except (OSError, ssl.SSLError, ValueError):
        return -1


def probe_gateways(gateways):
    from concurrent.futures import ThreadPoolExecutor
    hosts = [g["host"] for g in gateways if g.get("host")]
    if not hosts:
        return {}
    with ThreadPoolExecutor(max_workers=min(8, len(hosts))) as ex:
        return dict(zip(hosts, ex.map(probe_latency, hosts)))


def keyring_has(portal):  # replaced by the keyring section below
    return False


def status_json(portal):
    deps = check_deps()
    runfile = read_runfile()
    state_file = load_state()
    conn_state = nm_connection_state() if deps["nmOpenconnect"] else None
    state = derive_state(conn_state, runfile, portal, deps)
    out = {
        "state": state,
        "portal": portal,
        "gateway": state_file.get("gateway", ""),
        "username": state_file.get("username", ""),
        "authInterface": state_file.get("authInterface", ""),
        "hasSession": keyring_has(portal) if portal else False,
        "iface": "",
        "ip4": "",
        "since": 0,
        "rxBytes": 0,
        "txBytes": 0,
        "connectivity": nm_connectivity() if deps["nmOpenconnect"] else "unknown",
        "protocol": "",
        "gatewayIp": "",
        "routes": [],
        "fullTunnel": False,
        "dns": [],
        "searchDomains": [],
        "ip6": "",
        "resolver": {"dns": [], "domains": [], "active": False, "defaultRoute": False},
        "splitDns": split_dns_state() if deps["nmOpenconnect"] else "not-needed",
        "portals": known_portals(),
        "policy": state_file.get("policy") or {},
        "welcomeAvailable": bool((state_file.get("policy") or {}).get("welcomePage")),
        "detail": "",
        "deps": deps,
    }
    if state == "connected":
        d = nm_connection_details()
        ip = d.get("IP4.ADDRESS[1]", "").split("/")[0]
        # nmcli's IP-IFACE is the base device for VPNs; the tunnel (vpn0) is whichever device holds the VPN address.
        iface = (find_iface_for_ip(ip) if ip else "") or d.get("GENERAL.IP-IFACE", "")
        rx, tx = iface_stats(iface) if iface else (0, 0)
        try:
            since = int(d.get("connection.timestamp") or 0)
        except ValueError:
            since = 0
        routes = nm_routes(d)
        peers = socket_peers()
        gateway_ip = state_file.get("gatewayIp", "")
        if not gateway_ip:  # state written before the IP was recorded: the ESP peer is the gateway
            gateway_ip = next((p[1] for p in peers if p[0] == "udp" and p[2] == ESP_PORT), "")
        try:
            rs = run(["resolvectl", "status", iface], timeout=5) if iface else None
            resolver = parse_resolvectl_link(rs.stdout if rs and rs.returncode == 0 else "")
        except (OSError, subprocess.TimeoutExpired):
            resolver = parse_resolvectl_link("")
        out.update({
            "iface": iface, "ip4": ip, "ip6": global_ip6(d), "resolver": resolver, "since": since, "rxBytes": rx, "txBytes": tx,
            "protocol": detect_protocol(peers, gateway_ip), "gatewayIp": gateway_ip,
            "routes": routes, "fullTunnel": is_full_tunnel(routes),
            "dns": nm_list(d, "IP4.DNS"), "searchDomains": nm_list(d, "IP4.DOMAIN"),
        })
    elif runfile and runfile.get("alive"):
        out["detail"] = runfile.get("phase", "")
    return out


# --------------------------------------------------------------------------- sign-in window

def parse_theme_colors(text):
    colors = {"background": "#101315", "foreground": "#cacccc", "accent": "#cacccc"}
    for line in text.splitlines():
        m = re.match(r'^\s*(background|foreground|accent)\s*=\s*"(#[0-9A-Fa-f]{6})"', line)
        if m:
            colors[m.group(1)] = m.group(2)
    return colors


def theme_colors():
    p = _xdg("XDG_STATE_HOME", Path.home() / ".local/state") / "omarchy/current/theme/colors.toml"
    try:
        return parse_theme_colors(p.read_text())
    except OSError:
        return parse_theme_colors("")


def _gtk():
    """GTK 3 with the Omarchy theme applied; shared by the small dialogs."""
    import warnings
    import gi
    warnings.filterwarnings("ignore", category=DeprecationWarning)
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import GLib
    GLib.set_prgname(APP)
    from gi.repository import Gdk, Gtk
    colors = theme_colors()
    css = Gtk.CssProvider()
    css.load_from_data(f"""
      window, dialog, .gp-header {{ background-color: {colors['background']}; color: {colors['foreground']}; }}
      label {{ color: {colors['foreground']}; }}
      label.gp-title {{ font-weight: bold; font-size: 13px; }}
      label.gp-sub {{ opacity: 0.6; font-size: 11px; }}
      entry {{ background-color: {colors['background']}; color: {colors['foreground']}; border: 1px solid {colors['accent']}; border-radius: 4px; padding: 6px; caret-color: {colors['foreground']}; }}
      button {{ background-color: {colors['background']}; color: {colors['foreground']}; border: 1px solid {colors['accent']}; border-radius: 4px; padding: 4px 12px; }}
      button.suggested-action {{ background-color: {colors['accent']}; color: {colors['background']}; }}
      checkbutton {{ color: {colors['foreground']}; }}
    """.encode())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    return Gtk


def _dialog(Gtk, host, title_text, sub_text=""):
    dlg = Gtk.Dialog(title=f"Sign in · {host}")
    dlg.set_wmclass(APP, APP)
    dlg.set_default_size(420, -1)
    dlg.set_border_width(12)
    dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
    ok = dlg.add_button("Continue", Gtk.ResponseType.OK)
    ok.get_style_context().add_class("suggested-action")
    dlg.set_default_response(Gtk.ResponseType.OK)
    box = dlg.get_content_area()
    box.set_spacing(8)
    title = Gtk.Label(label=title_text, xalign=0)
    title.get_style_context().add_class("gp-title")
    title.set_line_wrap(True)
    box.pack_start(title, False, False, 0)
    if sub_text:
        sub = Gtk.Label(label=sub_text, xalign=0)
        sub.get_style_context().add_class("gp-sub")
        sub.set_line_wrap(True)
        box.pack_start(sub, False, False, 0)
    return dlg, box


def _run_dialog(Gtk, dlg):
    dlg.show_all()
    resp = dlg.run()
    dlg.destroy()
    while Gtk.events_pending():
        Gtk.main_iteration()
    return resp == Gtk.ResponseType.OK


def run_password_dialog(host, labels, message, username="", remember=False):
    """Username/password prompt with the portal's own labels. Returns (username, password, remember)."""
    Gtk = _gtk()
    dlg, box = _dialog(Gtk, host, message or f"Sign in to {host}", host if message else "")
    grid = Gtk.Grid(column_spacing=8, row_spacing=6)
    user_entry = Gtk.Entry(text=username)
    user_entry.set_hexpand(True)
    user_entry.set_activates_default(True)
    pass_entry = Gtk.Entry(visibility=False)
    pass_entry.set_hexpand(True)
    pass_entry.set_activates_default(True)
    pass_entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
    grid.attach(Gtk.Label(label=labels.get("usernameLabel", "Username"), xalign=0), 0, 0, 1, 1)
    grid.attach(user_entry, 1, 0, 1, 1)
    grid.attach(Gtk.Label(label=labels.get("passwordLabel", "Password"), xalign=0), 0, 1, 1, 1)
    grid.attach(pass_entry, 1, 1, 1, 1)
    box.pack_start(grid, False, False, 0)
    remember_check = Gtk.CheckButton(label="Remember the password in the keyring")
    remember_check.set_active(remember)
    box.pack_start(remember_check, False, False, 0)
    dlg.show_all()
    (pass_entry if username else user_entry).grab_focus()
    ok = _run_dialog(Gtk, dlg)
    u, pw, keep = user_entry.get_text().strip(), pass_entry.get_text(), remember_check.get_active()
    if not ok or not u or not pw:
        raise Cancelled("Sign-in cancelled")
    return u, pw, keep


def run_prompt_dialog(host, prompt, context=""):
    """One answer for whatever openconnect asked next (one-time code, push approval, challenge)."""
    Gtk = _gtk()
    dlg, box = _dialog(Gtk, host, prompt.rstrip(":"), context)
    entry = Gtk.Entry()
    entry.set_hexpand(True)
    entry.set_activates_default(True)
    low = prompt.lower()
    if "pass" in low or "pin" in low:
        entry.set_visibility(False)
        entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
    box.pack_start(entry, False, False, 0)
    dlg.show_all()
    entry.grab_focus()
    ok = _run_dialog(Gtk, dlg)
    text = entry.get_text()
    if not ok:
        raise Cancelled("Sign-in cancelled")
    return text


CALLBACK_DESKTOP = "omarchy-globalprotect-callback.desktop"


def ensure_callback_handler():
    """Register this CLI as the handler for globalprotectcallback: links (idempotent)."""
    apps = _xdg("XDG_DATA_HOME", Path.home() / ".local/share") / "applications"
    apps.mkdir(parents=True, exist_ok=True)
    exe = str(Path(sys.argv[0]).resolve())
    content = ("[Desktop Entry]\nType=Application\nName=GlobalProtect sign-in callback\n"
               f"Exec={shlex.quote(exe)} callback %u\nNoDisplay=true\nTerminal=false\n"
               "MimeType=x-scheme-handler/globalprotectcallback;\n")
    desktop = apps / CALLBACK_DESKTOP
    try:
        if not desktop.exists() or desktop.read_text() != content:
            desktop.write_text(content)
    except OSError as e:
        raise AuthError(f"Could not register the browser callback handler: {e}")
    for cmd in (["xdg-mime", "default", CALLBACK_DESKTOP, "x-scheme-handler/globalprotectcallback"],
                ["update-desktop-database", str(apps)]):
        try:
            run(cmd, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            pass


def callback_fifo():
    return runtime_dir() / "callback.fifo"


def wait_for_callback(timeout):
    """Block until the `callback` subcommand (launched by the browser) writes the callback URI."""
    import select
    import stat
    path = callback_fifo()
    try:
        if path.exists() and not stat.S_ISFIFO(path.stat().st_mode):
            path.unlink()
        if not path.exists():
            os.mkfifo(path, 0o600)
    except OSError as e:
        raise AuthError(f"Could not create the callback pipe: {e}")
    fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)  # O_RDWR: no spurious EOF while no writer is connected
    data = b""
    try:
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline and b"\n" not in data:
            ready, _, _ = select.select([fd], [], [], 0.5)
            if ready:
                try:
                    data += os.read(fd, 65536)
                except BlockingIOError:
                    pass
    finally:
        os.close(fd)
        try:
            path.unlink()
        except OSError:
            pass
    if not data.strip():
        raise AuthError("The browser never handed the sign-in back (does the portal support the default-browser flow?)")
    return data.decode("utf-8", "replace").strip().splitlines()[0]


def sign_in_browser(host, pre, timeout=300):
    """SAML in the default browser; the portal returns through a globalprotectcallback: link."""
    ensure_callback_handler()
    if pre["method"] == "REDIRECT":
        target = pre["request"]
    else:
        page = runtime_dir() / "saml-post.html"
        fd = os.open(page, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(pre["request"])
        target = page.as_uri()
    debug_log(f"browser sign-in: opening the {'redirect' if pre['method'] == 'REDIRECT' else 'posted form'} in the default browser")
    try:
        subprocess.Popen(["xdg-open", target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as e:
        raise AuthError(f"Could not open the browser: {e}")
    result = parse_callback_uri(wait_for_callback(int(os.environ.get("OMARCHY_GP_CALLBACK_TIMEOUT") or timeout)))
    return {"saml-username": result["username"], "prelogin-cookie": result["token"], "saml-auth-status": "1"}


def run_sso_window(portal, method, request, timeout_s=300):
    """Open the SAML page in a themed WebKit window; return the SAML result fields.

    Raises Cancelled when the user closes the window, AuthError on timeout or load failure.
    """
    import signal
    import warnings
    import gi
    # GTK 3 / PyGObject deprecation notices are noise on stderr for our purposes.
    warnings.filterwarnings("ignore", category=DeprecationWarning)
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("WebKit2", "4.1")
    gi.require_version("Soup", "3.0")
    from gi.repository import GLib
    GLib.set_prgname(APP)  # becomes the Wayland app_id; must precede Gtk init
    from gi.repository import Gdk, Gtk, WebKit2
    try:
        from gi import PyGIDeprecationWarning
        warnings.filterwarnings("ignore", category=PyGIDeprecationWarning)
    except ImportError:
        pass

    colors = theme_colors()
    wk = _private_dir(data_dir() / "webkit")
    manager = WebKit2.WebsiteDataManager(base_data_directory=str(wk / "data"), base_cache_directory=str(wk / "cache"))
    manager.get_cookie_manager().set_persistent_storage(str(wk / "cookies.sqlite"), WebKit2.CookiePersistentStorage.SQLITE)
    ctx = WebKit2.WebContext.new_with_website_data_manager(manager)
    view = WebKit2.WebView.new_with_context(ctx)
    outcome = {"result": {}, "error": None, "done": False, "destroyed": False}

    win = Gtk.Window(title=f"Sign in · {portal}")
    win.set_default_size(480, 720)
    win.set_wmclass(APP, APP)

    css = Gtk.CssProvider()
    css.load_from_data(f"""
      window, .gp-header {{ background-color: {colors['background']}; color: {colors['foreground']}; }}
      label.gp-title {{ font-weight: bold; font-size: 13px; }}
      label.gp-sub {{ opacity: 0.6; font-size: 11px; }}
      progressbar trough {{ min-height: 2px; background-color: {colors['background']}; border: none; }}
      progressbar progress {{ min-height: 2px; background-color: {colors['accent']}; border: none; }}
    """.encode())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    header = Gtk.Box(spacing=10)
    header.get_style_context().add_class("gp-header")
    header.set_border_width(12)
    labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    title = Gtk.Label(label="Signing in with Google", xalign=0)
    title.get_style_context().add_class("gp-title")
    sub = Gtk.Label(label=portal, xalign=0)
    sub.get_style_context().add_class("gp-sub")
    labels.pack_start(title, False, False, 0)
    labels.pack_start(sub, False, False, 0)
    spinner = Gtk.Spinner()
    header.pack_start(labels, True, True, 0)
    header.pack_end(spinner, False, False, 0)
    progress = Gtk.ProgressBar()
    box.pack_start(header, False, False, 0)
    box.pack_start(progress, False, False, 0)
    box.pack_start(view, True, True, 0)
    win.add(box)

    def close_window():
        if not outcome["destroyed"]:
            outcome["destroyed"] = True
            win.destroy()
        return False

    def finish(error=None):
        if outcome["done"]:
            return
        outcome["done"] = True
        outcome["error"] = error
        spinner.stop()
        if error is None:
            title.set_text("Signed in")
            sub.set_text(outcome["result"].get("saml-username") or portal)
            GLib.timeout_add(600, close_window)
        else:
            GLib.idle_add(close_window)

    def consider(fields):
        if outcome["done"] or not fields:
            return
        for k, v in fields.items():
            outcome["result"].setdefault(k, v)
        if saml_result_complete(outcome["result"]):
            finish()

    def on_resource(_view, resource, _request):
        def on_finished(res):
            resp = res.get_response()
            if not resp:
                return
            headers = {}
            http_headers = resp.get_http_headers()
            if http_headers is not None:
                http_headers.foreach(lambda n, v: headers.__setitem__(n, v))
            consider(extract_saml_result(headers, None))
        resource.connect("finished", on_finished)

    def on_js(v, res, *_):
        try:
            html = v.evaluate_javascript_finish(res).to_string()
        except Exception:
            return
        consider(extract_saml_result(None, html))

    def on_load_changed(_view, event):
        loading = event != WebKit2.LoadEvent.FINISHED
        progress.set_visible(loading)
        if loading:
            spinner.start()
            return
        spinner.stop()
        view.evaluate_javascript("document.documentElement.outerHTML", -1, None, None, None, on_js, None)

    def on_load_failed(_view, _event, uri, error):
        # Navigations interrupted by a redirect surface as "cancelled"; that is normal during SSO.
        if error.matches(WebKit2.NetworkError.quark(), WebKit2.NetworkError.CANCELLED):
            return False
        title.set_text("Could not load the sign-in page")
        sub.set_text(error.message)
        spinner.stop()
        return False  # let WebKit render its error page; the user can close the window

    def on_destroy(*_):
        outcome["destroyed"] = True
        if not outcome["done"]:
            outcome["done"] = True
            outcome["error"] = "Sign-in window closed"
        Gtk.main_quit()

    def on_timeout():
        finish("Sign-in timed out")
        return False

    def on_term(*_):
        finish("Sign-in interrupted")
        return False

    view.connect("resource-load-started", on_resource)
    view.connect("load-changed", on_load_changed)
    view.connect("load-failed", on_load_failed)
    view.connect("notify::estimated-load-progress", lambda v, _p: progress.set_fraction(v.get_estimated_load_progress()))
    win.connect("destroy", on_destroy)
    GLib.timeout_add_seconds(timeout_s, on_timeout)
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, on_term)
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, on_term)

    if method == "REDIRECT":
        view.load_uri(request)
    else:
        view.load_html(request, f"https://{portal}/")
    win.show_all()
    progress.set_visible(True)
    spinner.start()
    Gtk.main()

    # WebKit creates the cookie jar 0644; the 0700 directory already guards it,
    # but keep the file itself private too.
    for name in ("cookies.sqlite", "cookies.sqlite-wal", "cookies.sqlite-shm"):
        try:
            (wk / name).chmod(0o600)
        except OSError:
            pass

    if outcome["error"]:
        if "closed" in outcome["error"] or "interrupted" in outcome["error"]:
            raise Cancelled(outcome["error"])
        raise AuthError(outcome["error"])
    return outcome["result"]


# --------------------------------------------------------------------------- portal + openconnect

def prelogin_url(host, interface):
    return f"https://{host}/{PRELOGIN_PATHS[interface]}"


def interfaces_to_try(setting):
    s = str(setting or "auto").strip().lower()
    return [s] if s in ("portal", "gateway") else ["gateway", "portal"]


def pick_prelogin(portal, client_os, setting, gateway=""):
    """Return (interface, host, prelogin result) for the first interface that offers SAML."""
    last = None
    fallback = None
    for iface in interfaces_to_try(setting):
        host = signin_host(portal, iface, gateway)
        try:
            pre = prelogin(host, client_os, interface=iface)
        except PreloginError as e:
            debug_log(f"prelogin via {iface} rejected: {e}")
            last = e
            continue
        if pre["method"] != "PASSWORD":
            return iface, host, pre
        if fallback is None:  # keep looking for SAML; use the password form only if nothing offers SSO
            fallback = (iface, host, pre)
    if fallback:
        return fallback
    raise last


def http_opener():
    """urllib opener that honours the proxy and client-certificate options."""
    import ssl
    ctx = ssl.create_default_context()
    if OPTS["certificate"]:
        try:
            ctx.load_cert_chain(OPTS["certificate"], OPTS["key"] or None)
        except (OSError, ssl.SSLError) as e:
            raise PreloginError(f"Could not load the client certificate: {e}")
    handlers = [urllib.request.HTTPSHandler(context=ctx)]
    if OPTS["proxy"]:
        handlers.append(urllib.request.ProxyHandler({"http": OPTS["proxy"], "https": OPTS["proxy"]}))
    return urllib.request.build_opener(*handlers)


def prelogin(portal, client_os, timeout=20, interface="portal"):
    fields = {"tmp": "tmp", "kerberos-support": "yes", "ipv6-support": "yes", "clientVer": "4100", "clientos": client_os}
    if OPTS["browser"]:
        fields.update({"default-browser": "1", "cas-support": "yes"})
    body = urllib.parse.urlencode(fields).encode()
    req = urllib.request.Request(
        prelogin_url(portal, interface), data=body, method="POST",
        headers={"User-Agent": "PAN GlobalProtect", "Content-Type": "application/x-www-form-urlencoded"},
    )
    debug_log(f"prelogin POST {prelogin_url(portal, interface)} clientos={client_os} browser={OPTS['browser']}")
    try:
        with http_opener().open(req, timeout=timeout) as resp:
            pre = parse_prelogin(resp.read().decode("utf-8", "replace"))
            debug_log(f"prelogin ok: method={pre['method']}" + (" default-browser=yes" if pre.get("defaultBrowser") else ""))
            return pre
    except urllib.error.URLError as e:
        debug_log(f"prelogin failed: {getattr(e, 'reason', e)}")
        raise PreloginError(f"Could not reach {portal}: {getattr(e, 'reason', e)}")
    except OSError as e:
        raise PreloginError(f"Could not reach {portal}: {e}")


def authenticate_command(portal, cookie_kind, username, client_os, gateway, hip_script, interface="portal",
                         proxy="", certificate="", key=""):
    """openconnect argv; cookie_kind None means a password login (usergroup without a cookie suffix)."""
    usergroup = f"{interface}:{cookie_kind}" if cookie_kind else interface
    cmd = [
        "openconnect", "--protocol=gp", "--authenticate", "--non-inter", f"--os={client_os}", f"--user={username}",
        f"--usergroup={usergroup}", "--passwd-on-stdin",
    ]
    if gateway and interface == "portal":
        cmd.append(f"--authgroup={gateway}")
    if hip_script:
        cmd.append(f"--csd-wrapper={hip_script}")
    if proxy:
        cmd.append(f"--proxy={proxy}")
    if certificate:
        cmd.append(f"--certificate={certificate}")
    if key:
        cmd.append(f"--sslkey={key}")
    cmd.append(portal)
    return cmd


def last_meaningful_line(text):
    skip = ("Connected to", "SSL negotiation", "Connected to HTTPS", "Getting login form", "POST https://", "GET https://")
    lines = [l.strip() for l in (text or "").splitlines() if l.strip() and not l.strip().startswith(skip)]
    return lines[-1][:200] if lines else ""


def authenticate(portal, cookie_kind, cookie, username, client_os, gateway, hip_script, timeout=60, interface="portal"):
    """Exchange a SAML cookie for a session cookie; the cookie travels over stdin only."""
    cmd = authenticate_command(portal, cookie_kind, username, client_os, gateway, hip_script, interface,
                               OPTS["proxy"], OPTS["certificate"], OPTS["key"])
    debug_log("openconnect " + " ".join(cmd[1:]))
    try:
        r = run(cmd, timeout=timeout, input_text=cookie + "\n")
    except subprocess.TimeoutExpired:
        raise AuthError("openconnect timed out talking to the portal")
    except OSError as e:
        raise AuthError(f"Could not run openconnect: {e}")
    auth = parse_authenticate_output(r.stdout)
    debug_log(f"openconnect --authenticate rc={r.returncode} host={auth.get('HOST', '')} connect_url={auth.get('CONNECT_URL', '')} "
              f"fingerprint={auth.get('FINGERPRINT', '')} resolve={auth.get('RESOLVE', '')} stderr={last_meaningful_line(r.stderr)!r}")
    if r.returncode != 0 or not all(auth.get(k) for k in ("COOKIE", "CONNECT_URL", "FINGERPRINT")):
        raise AuthError(last_meaningful_line(r.stderr) or "Portal login failed")
    return auth


def authenticate_interactive(host, username, password, client_os, gateway, hip_script, interface, prompt_cb,
                             timeout=180, openconnect_bin="openconnect"):
    """Password login driven through a pty: the first password prompt gets `password`, any later prompt
    (one-time code, push approval, challenge) goes to prompt_cb(prompt, context) which may raise Cancelled."""
    import pty
    import select
    import termios
    cmd = authenticate_command(host, None, username, client_os, gateway, hip_script, interface,
                               OPTS["proxy"], OPTS["certificate"], OPTS["key"])
    cmd = [openconnect_bin] + [a for a in cmd[1:] if a not in ("--non-inter", "--passwd-on-stdin")]
    debug_log("openconnect (interactive) " + " ".join(cmd[1:]))
    master, slave = pty.openpty()
    try:  # never echo what we type back into the transcript
        attrs = termios.tcgetattr(slave)
        attrs[3] &= ~termios.ECHO
        termios.tcsetattr(slave, termios.TCSANOW, attrs)
    except termios.error:
        pass
    try:
        proc = subprocess.Popen(cmd, stdin=slave, stdout=slave, stderr=slave, close_fds=True, start_new_session=True)
    except OSError as e:
        os.close(master)
        os.close(slave)
        raise AuthError(f"Could not run openconnect: {e}")
    os.close(slave)
    buf, answered, deadline = "", False, time.monotonic() + timeout
    try:
        while True:
            ready, _, _ = select.select([master], [], [], 0.5)
            if ready:
                try:
                    chunk = os.read(master, 4096)
                except OSError:
                    chunk = b""
                if not chunk:
                    break
                buf += chunk.decode("utf-8", "replace").replace("\r", "")
                prompt = prompt_pending(buf)
                if prompt:
                    low = prompt.lower()
                    if "user" in low and "name" in low:
                        answer = username
                    elif not answered:
                        answer, answered = password, True
                    else:
                        context = "\n".join(l for l in buf.splitlines()[-6:-1] if l.strip())
                        answer = prompt_cb(prompt, context)
                    os.write(master, (answer + "\n").encode())
                    buf += "\n"
                continue
            if proc.poll() is not None:
                break
            if time.monotonic() > deadline:
                raise AuthError("openconnect timed out waiting for a response")
    finally:
        if proc.poll() is None:
            try:
                proc.kill()
            except OSError:
                pass
        proc.wait()
        os.close(master)
    auth = parse_authenticate_output(buf)
    debug_log(f"openconnect (interactive) rc={proc.returncode} keys={sorted(auth)}")
    if proc.returncode != 0 or not all(auth.get(k) for k in ("COOKIE", "CONNECT_URL", "FINGERPRINT")):
        raise AuthError(last_meaningful_line(buf) or "Login failed")
    return auth


def authenticate_with_password(host, username, password, client_os, gateway, hip_script, interface, portal):
    """Interactive login with dialogs for challenges; a remembered password that stopped working is asked again once."""
    def ask(prompt, context=""):
        return run_prompt_dialog(host, prompt, context)

    try:
        return authenticate_interactive(host, username, password, client_os, gateway, hip_script, interface, ask)
    except AuthError as e:
        if credential_lookup(portal, username) != password:
            raise
        credential_clear(portal, username)
        debug_log("stored password rejected; asking again")
        username, password, remember = run_password_dialog(host, {}, str(e), username)
        if remember:
            credential_store(portal, username, password)
        save_state(username=username)
        return authenticate_interactive(host, username, password, client_os, gateway, hip_script, interface, ask)


def hip_script_path():
    return next((p for p in HIP_SCRIPTS if Path(p).exists()), None)


# --------------------------------------------------------------------------- keyring (secret-tool)

def _keyring_attrs(portal):
    return ["application", APP, "portal", portal, "kind", "portal-userauthcookie"]


def keyring_store(portal, cookie):
    try:
        run(["secret-tool", "store", f"--label=GlobalProtect session ({portal})", *_keyring_attrs(portal)], input_text=cookie)
    except (OSError, subprocess.TimeoutExpired):
        pass


def keyring_lookup(portal):
    try:
        r = run(["secret-tool", "lookup", *_keyring_attrs(portal)])
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    return r.stdout.strip() or None


def keyring_has(portal):  # noqa: F811 — replaces the placeholder above
    return keyring_lookup(portal) is not None


def _credential_attrs(portal, username):
    return ["application", APP, "portal", portal, "user", username, "kind", "password"]


def credential_store(portal, username, password):
    try:
        run(["secret-tool", "store", f"--label=GlobalProtect password ({username} @ {portal})",
             *_credential_attrs(portal, username)], input_text=password)
    except (OSError, subprocess.TimeoutExpired):
        pass


def credential_lookup(portal, username):
    if not username:
        return None
    try:
        r = run(["secret-tool", "lookup", *_credential_attrs(portal, username)])
    except (OSError, subprocess.TimeoutExpired):
        return None
    return (r.stdout.strip() or None) if r.returncode == 0 else None


def credential_clear(portal, username):
    try:
        run(["secret-tool", "clear", *_credential_attrs(portal, username)])
    except (OSError, subprocess.TimeoutExpired):
        pass


def keyring_clear(portal):
    try:
        run(["secret-tool", "clear", "application", APP, "portal", portal])
    except (OSError, subprocess.TimeoutExpired):
        pass


# --------------------------------------------------------------------------- NetworkManager

def current_user():
    user = os.environ.get("USER")
    if user:
        return user
    try:
        import pwd
        return pwd.getpwuid(os.getuid()).pw_name
    except (KeyError, ImportError):
        return os.getlogin()


def nm_profile_command(exists, data):
    """nmcli argv that creates or updates the GlobalProtect profile.

    The profile is a system connection on purpose: nm-openconnect rejects
    "private" connections (ones scoped with connection.permissions), and the
    wheel + local-session polkit rule lets us manage system connections
    without a prompt anyway. modify also clears any permissions left over from
    an older profile.

    vpn.persistent keeps NetworkManager from tearing the tunnel down on a link
    change (Wi-Fi roam, cable swap, resume from suspend); openconnect then
    reconnects with the same session cookie until it expires.
    """
    if not exists:
        return ["nmcli", "connection", "add", "type", "vpn", "con-name", NM_CONNECTION, "ifname", "*", "vpn-type", "openconnect",
                "vpn.persistent", "yes", "vpn.data", data]
    return ["nmcli", "connection", "modify", NM_CONNECTION, "connection.permissions", "", "vpn.persistent", "yes", "vpn.data", data]


def ensure_nm_profile(portal, hip, hip_script=None):
    """Create or update the GlobalProtect NM profile. Idempotent."""
    if hip and hip_script is None:
        hip_script = hip_script_path()
    data = build_vpn_data(portal, hip, hip_script, OPTS["proxy"], OPTS["certificate"], OPTS["key"], OPTS["ssl_only"], OPTS["mtu"])
    cmd = nm_profile_command(nm_connection_state() is not None, data)
    debug_log(" ".join(cmd))
    try:
        r = run(cmd, timeout=20)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise AuthError(f"NetworkManager profile setup failed: {e}")
    if r.returncode != 0:
        raise AuthError(f"NetworkManager profile setup failed: {last_meaningful_line(r.stderr)}")


def apply_lan_block(enabled):
    """Route the physical LAN subnets into the tunnel (which drops them) when "no local network" is on."""
    subnets = []
    if enabled:
        try:
            subnets = lan_subnets(json.loads(run(["ip", "-j", "route", "show"]).stdout), "")
        except (OSError, ValueError, subprocess.TimeoutExpired):
            subnets = []
    debug_log(f"lan block {'on' if enabled else 'off'}: {subnets}")
    try:
        run(["nmcli", "connection", "modify", NM_CONNECTION, "ipv4.routes", ",".join(subnets)], timeout=20)
    except (OSError, subprocess.TimeoutExpired) as e:
        warn(f"Could not update the local-network block: {e}")


def apply_split_dns(mode):
    """After activation: point the tunnel link's DNS at what the gateway pushed, if the polkit rule allows it."""
    if mode == "off":
        return
    if split_dns_state() == "needed":
        debug_log("split dns: global DNS override present and the polkit rule is not installed; skipping")
        return
    d = nm_connection_details()
    ip = d.get("IP4.ADDRESS[1]", "").split("/")[0]
    iface = find_iface_for_ip(ip) if ip else ""
    routes = nm_routes(d)
    plan = split_dns_plan(iface, nm_list(d, "IP4.DNS"), nm_list(d, "IP4.DOMAIN"), is_full_tunnel(routes), mode)
    for cmd in plan:
        try:
            r = run(cmd, timeout=15)
            debug_log(" ".join(cmd) + f" rc={r.returncode} {last_meaningful_line(r.stderr)!r}")
            if r.returncode != 0:
                warn(f"DNS setup failed: {last_meaningful_line(r.stderr) or ' '.join(cmd)}")
                return
        except (OSError, subprocess.TimeoutExpired) as e:
            warn(f"DNS setup failed: {e}")
            return


def nm_up(auth, timeout=60):
    path = runtime_dir() / f"secrets.{os.getpid()}"
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(render_passwd_file(auth))
        r = run(["nmcli", "--wait", str(timeout), "connection", "up", NM_CONNECTION, "passwd-file", str(path)], timeout=timeout + 10)
        debug_log(f"nmcli connection up rc={r.returncode} {last_meaningful_line(r.stderr)!r}")
        if r.returncode != 0:
            raise AuthError(last_meaningful_line(r.stderr) or "NetworkManager could not bring the tunnel up")
    except subprocess.TimeoutExpired:
        raise AuthError("NetworkManager took too long to bring the tunnel up")
    finally:
        try:
            path.unlink()
        except FileNotFoundError:
            pass


def nm_down():
    try:
        r = run(["nmcli", "connection", "down", NM_CONNECTION], timeout=30)
        debug_log(f"nmcli connection down rc={r.returncode} {last_meaningful_line(r.stderr)!r}")
    except (OSError, subprocess.TimeoutExpired) as e:
        raise AuthError(f"Disconnect failed: {e}")
    if r.returncode != 0 and "not an active connection" not in r.stderr and "unknown connection" not in r.stderr:
        raise AuthError(last_meaningful_line(r.stderr) or "Disconnect failed")


# --------------------------------------------------------------------------- subcommands

def emit(phase):
    print(f"phase={phase}", flush=True)
    write_runfile(phase)


def warn(msg):
    print(f"warning={msg}", file=sys.stderr, flush=True)


def fail(msg, code=1):
    debug_log(f"error({code}): {msg}")
    print(f"error={msg}", file=sys.stderr, flush=True)
    clear_runfile()
    sys.exit(code)


def resolve_portal(args):
    portal = (getattr(args, "portal", "") or load_state().get("portal") or "").strip()
    portal = re.sub(r"^https?://", "", portal).rstrip("/")
    return portal


def sign_in(portal, client_os, auth_interface="auto", gateway="", announce=True):
    """SAML sign-in; returns (cookie kind, cookie, username, interface, host the sign-in happened at)."""
    if announce:
        emit("signing-in")
    iface, host, pre = pick_prelogin(portal, CLIENT_OS.get(client_os, "Windows"), auth_interface, gateway)
    if pre["method"] == "PASSWORD":
        username = load_state().get("username", "")
        stored = credential_lookup(portal, username) if not OPTS["fresh"] else None
        if stored:
            password = stored
            debug_log(f"password login: using the remembered password for {username}")
        else:
            username, password, remember = run_password_dialog(host, pre, pre["message"], username)
            if remember:
                credential_store(portal, username, password)
            else:
                credential_clear(portal, username)
            debug_log(f"password login: user={username} remember={remember}")
        if announce:
            save_state(username=username, portal=portal, authInterface=iface)
        else:
            save_state(username=username, portal=portal)
        return "password", password, username, iface, host
    if OPTS["browser"] and pre.get("defaultBrowser"):
        result = sign_in_browser(host, pre)
    else:
        if OPTS["browser"]:
            warn("Portal does not advertise the default-browser flow; using the embedded sign-in window")
        result = run_sso_window(host, pre["method"], pre["request"])
    kind, cookie = choose_cookie(result)
    username = result["saml-username"]
    debug_log(f"sso done: interface={iface} host={host} cookie-kind={kind} user={username} portal-cookie={'yes' if result.get('portal-userauthcookie') else 'no'}")
    if result.get("portal-userauthcookie"):
        keyring_store(portal, result["portal-userauthcookie"])
    if announce:
        save_state(username=username, portal=portal, authInterface=iface)
    else:
        save_state(username=username, portal=portal)
    return kind, cookie, username, iface, host


def _install_term_handler():
    import signal

    def on_term(signum, _frame):
        raise Cancelled("Interrupted")

    signal.signal(signal.SIGTERM, on_term)


def cmd_connect(args):
    _install_term_handler()
    portal = resolve_portal(args)
    if not portal:
        fail("No portal configured", 1)
    deps = check_deps()
    if not all(deps.values()):
        fail("Missing dependencies: " + ", ".join(k for k, v in deps.items() if not v), 3)
    try:
        emit("preparing")
        hip_script = hip_script_path() if args.hip else None
        if args.hip and hip_script is None:
            warn("HIP report requested but openconnect's hipreport.sh was not found; continuing without HIP")
        use_hip = bool(args.hip and hip_script)
        state = load_state()
        choice = resolve_gateway_choice(args.gateway, state)
        debug_log(f"connect portal={portal} gateway={args.gateway!r} choice={choice!r} os={args.client_os} hip={use_hip} interface={args.auth_interface} fresh={args.fresh}")
        ensure_nm_profile(portal, use_hip, hip_script)
        auth = None
        username = state.get("username", "")
        if not args.fresh and username:
            cookie = keyring_lookup(portal)
            debug_log(f"keyring portal cookie: {'found' if cookie else 'absent'}")
            if cookie:
                emit("authenticating")
                try:
                    auth = authenticate(portal, "portal-userauthcookie", cookie, username, args.client_os, choice, hip_script, interface="portal")
                except AuthError:
                    keyring_clear(portal)
                    auth = None
        if auth is None:
            kind, cookie, username, iface, host = sign_in(portal, args.client_os, args.auth_interface, gateway=choice)
            emit("authenticating")
            if kind == "password":
                auth = authenticate_with_password(host, username, cookie, args.client_os, choice, hip_script, iface, portal)
            else:
                auth = authenticate(host, kind, cookie, username, args.client_os, choice, hip_script, interface=iface)
        gateway_host = urllib.parse.urlsplit(auth["CONNECT_URL"]).hostname or ""
        save_state(gateway=gateway_host, gatewayIp=resolve_host(gateway_host) if gateway_host else "", portal=portal)
        emit("activating")
        apply_lan_block(OPTS["block_lan"])
        nm_up(auth)
        apply_split_dns(OPTS["dns_mode"])
        emit("connected")
        clear_runfile()
    except Cancelled as e:
        fail(str(e), 2)
    except (PreloginError, AuthError) as e:
        fail(str(e), 1)
    except KeyboardInterrupt:
        fail("Interrupted", 2)


def cmd_login(args):
    _install_term_handler()
    portal = resolve_portal(args)
    if not portal:
        fail("No portal configured")
    try:
        sign_in(portal, args.client_os, args.auth_interface, gateway=resolve_gateway_choice(args.gateway, load_state()))
        clear_runfile()
        print("phase=signed-in", flush=True)
    except Cancelled as e:
        fail(str(e), 2)
    except (PreloginError, AuthError) as e:
        fail(str(e))
    except KeyboardInterrupt:
        fail("Interrupted", 2)


def cmd_disconnect(args):
    try:
        nm_down()
    except AuthError as e:
        fail(str(e))


def show_html_window(title, html, size=(560, 640)):
    """A themed WebKit window showing portal-provided HTML (welcome / help page)."""
    import warnings
    import gi
    warnings.filterwarnings("ignore", category=DeprecationWarning)
    gi.require_version("Gtk", "3.0")
    gi.require_version("WebKit2", "4.1")
    from gi.repository import GLib
    GLib.set_prgname(APP)
    from gi.repository import Gtk, WebKit2
    _gtk()
    win = Gtk.Window(title=title)
    win.set_wmclass(APP, APP)
    win.set_default_size(*size)
    view = WebKit2.WebView()
    view.load_html(html, "about:blank")
    win.add(view)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


def cmd_welcome(args):
    """The portal's welcome page: --show opens it in a window, otherwise the HTML is printed."""
    portal = resolve_portal(args)
    page = ((load_state(portal).get("policy") or {}).get("welcomePage") or "") if portal else ""
    if not page:
        fail("The portal has no welcome page", 1)
    if args.show:
        save_state(portal=portal, welcomeShown=(load_state(portal).get("policy") or {}).get("configDigest", ""))
        show_html_window(f"Welcome · {portal}", page)
    else:
        sys.stdout.write(page + "\n")


def cmd_hip_status(args):
    """Last HIP check and submission seen in openconnect's journal, plus any warning."""
    print(json.dumps(hip_journal_status()))


def cmd_split_dns_rule(args):
    """Prints the polkit rule the enable-split-dns helper installs (via pkexec)."""
    sys.stdout.write(split_dns_rule())


def cmd_callback(args):
    """Invoked by the desktop handler with the globalprotectcallback: URI; hands it to the waiting sign-in."""
    set_debug(True)  # the handler runs without our flags; a browser round-trip must always be traceable
    debug_log("callback received from the browser")
    try:
        fd = os.open(callback_fifo(), os.O_WRONLY | os.O_NONBLOCK)
    except OSError:
        try:
            run(["notify-send", "-a", "GlobalProtect", "-i", "dialog-warning", "Sign-in callback", "No GlobalProtect sign-in is waiting for it"], timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            pass
        fail("No sign-in is waiting for a callback", 1)
    try:
        os.write(fd, (args.uri.strip() + "\n").encode())
    finally:
        os.close(fd)


def cmd_forget(args):
    """Drop the stored session for a portal; --remove also drops the portal itself (its gateways, policy, everything)."""
    portal = resolve_portal(args)
    if portal:
        keyring_clear(portal)
    if args.remove and portal:
        forget_portal(portal)
        return
    if portal:
        path = _portal_state_path(portal)
        bucket = _read_json(path)
        for k in ("username", "gateway", "gatewayIp"):
            bucket.pop(k, None)
        _write_json(path, bucket)
    else:
        base = _read_json(state_dir() / "state.json")
        for k in ("username", "gateway", "gatewayIp"):
            base.pop(k, None)
        _write_json(state_dir() / "state.json", base)
    shutil.rmtree(data_dir() / "webkit", ignore_errors=True)


def cmd_status(args):
    print(json.dumps(status_json(resolve_portal(args))))


def cmd_deps(args):
    print(json.dumps(check_deps()))


def hip_report_preview(client_os, username, ip):
    script = hip_script_path()
    if not script:
        raise HipError("openconnect's hipreport.sh is not installed")
    try:
        r = run(hip_report_command(script, username, socket.gethostname(), ip, client_os), timeout=15)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise HipError(f"HIP report script failed: {e}")
    if r.returncode != 0:
        raise HipError(last_meaningful_line(r.stderr) or "HIP report script failed")
    return parse_hip_report(r.stdout)


def _cmd_text(cmd, timeout=20):
    try:
        r = run(cmd, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"<{' '.join(cmd)} failed: {e}>\n"
    return (r.stdout or "") + (f"\n[stderr]\n{r.stderr}" if r.stderr else "")


def collect_logs_members(portal, client_os):
    """Everything a maintainer needs to see, with cookies and passwords masked."""
    state = load_state()
    members = {
        "status.json": json.dumps(status_json(portal), indent=1),
        "deps.json": json.dumps(check_deps()),
        "versions.txt": _cmd_text(["openconnect", "--version"])
        + _cmd_text(["pacman", "-Q", "networkmanager", "networkmanager-openconnect", "openconnect", "webkit2gtk-4.1", "python-gobject"])
        + _cmd_text(["omarchy", "version"]),
        "nm-profile.txt": _cmd_text(["nmcli", "connection", "show", NM_CONNECTION]),
        "journal-networkmanager.txt": _cmd_text(["journalctl", "-u", "NetworkManager", "--since", "-2 days", "-n", "5000", "-o", "short-iso", "--no-pager"], timeout=60),
        "journal-openconnect.txt": _cmd_text(["journalctl", "-t", "openconnect", "-t", "nm-openconnect-service", "--since", "-2 days", "-n", "5000", "-o", "short-iso", "--no-pager"], timeout=60),
        "state.json": json.dumps(state, indent=1),
    }
    dbg = state_dir() / "debug.log"
    if dbg.exists():
        members["debug.log"] = dbg.read_text(errors="replace")
    try:
        members["hip-report.json"] = json.dumps(hip_report_preview(client_os, state.get("username", ""), ""), indent=1)
    except HipError as e:
        members["hip-report.json"] = json.dumps({"error": str(e)})
    return {name: scrub_secrets(text) for name, text in members.items()}


def default_bundle_dir():
    downloads = Path.home() / "Downloads"
    return downloads if downloads.is_dir() else state_dir()


def cmd_collect_logs(args):
    """The official client's collect-log: one tarball to attach to a bug report."""
    base = Path(args.output).expanduser() if args.output else default_bundle_dir()
    try:
        base.mkdir(parents=True, exist_ok=True)
        path = bundle_path(base, datetime.datetime.now())
        write_bundle(path, collect_logs_members(resolve_portal(args), args.client_os))
    except OSError as e:
        fail(f"Could not write the log bundle: {e}")
    print(f"path={path}", flush=True)


def cmd_gateways(args):
    """The portal's gateway list: --refresh signs in at the portal and fetches it, --probe times each gateway."""
    portal = resolve_portal(args)
    if not portal:
        fail("No portal configured")
    try:
        if args.refresh:
            cfg = None
            state0 = load_state(portal)
            stored = keyring_lookup(portal)
            if stored and state0.get("username"):
                try:  # the portal cookie makes this a silent refresh (what the official client does on its interval)
                    cfg = fetch_portal_config(portal, state0["username"], "", args.client_os, userauthcookie=stored)
                    debug_log("portal config refreshed silently with the stored portal cookie")
                except PortalConfigError as e:
                    debug_log(f"silent portal refresh failed: {e}")
                    cfg = None
            if cfg is None and args.quiet:
                fail("Silent refresh needs a valid portal session", 4)
            if cfg is None:
                kind, cookie, username, _iface, _host = sign_in(portal, args.client_os, "portal", announce=False)
                if kind == "password":
                    cfg = fetch_portal_config(portal, username, "", args.client_os, password=cookie)
                elif kind == "prelogin-cookie":
                    cfg = fetch_portal_config(portal, username, cookie, args.client_os)
                else:
                    raise PortalConfigError("Portal sign-in returned no prelogin cookie")
            if cfg["portalUserAuthCookie"]:
                keyring_store(portal, cfg["portalUserAuthCookie"])
            save_state(portal=portal, gateways=cfg["gateways"], gatewaysFetchedAt=int(time.time()), portalName=cfg["portalName"],
                       hipInterval=cfg["hipInterval"], policy=cfg["policy"])
        state = load_state()
        if args.probe and state.get("gateways"):
            save_state(latencies=probe_gateways(state["gateways"]), probedAt=int(time.time()))
            state = load_state()
    except Cancelled as e:
        fail(str(e), 2)
    except (PreloginError, AuthError, PortalConfigError) as e:
        fail(str(e))
    gws = state.get("gateways") or []
    lat = state.get("latencies") or {}
    print(json.dumps({
        "portal": portal,
        "portalName": state.get("portalName", ""),
        "policy": state.get("policy") or {},
        "gateways": [dict(g, latencyMs=lat.get(g["host"], -1) if g["host"] in lat else None) for g in gws],
        "fetchedAt": state.get("gatewaysFetchedAt", 0),
        "probedAt": state.get("probedAt", 0),
        "selected": args.gateway,
        "best": best_gateway(gws, lat),
    }))


def cmd_hip_report(args):
    """What the HIP report says about this machine (the official client's Host Profile tab)."""
    state = load_state()
    out = {"enabled": bool(args.hip), "script": hip_script_path() or "", "clientOs": args.client_os, "report": None, "error": ""}
    try:
        out["report"] = hip_report_preview(args.client_os, state.get("username", ""), "")
    except HipError as e:
        out["error"] = str(e)
    print(json.dumps(out))


def main(argv=None):
    p = argparse.ArgumentParser(prog=APP, description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    def common(sp):
        sp.add_argument("--portal", default="", help="portal hostname (defaults to the last used one)")
        sp.add_argument("--gateway", default="", help="gateway name to select (openconnect --authgroup)")
        sp.add_argument("--client-os", dest="client_os", default="win", choices=list(CLIENT_OS), help="OS to report to the portal")
        sp.add_argument("--hip", action="store_true", help="submit openconnect's HIP report")
        sp.add_argument("--fresh", action="store_true", help="ignore any stored session and sign in again")
        sp.add_argument("--auth-interface", dest="auth_interface", default="auto", choices=list(AUTH_INTERFACES),
                        help="where to do the SAML sign-in: gateway, portal, or auto (probe gateway first)")
        sp.add_argument("--debug", action="store_true", help="append each step to the debug log in $XDG_STATE_HOME")
        sp.add_argument("--browser", action="store_true", help="SAML in the default browser via the globalprotectcallback: handler")
        sp.add_argument("--proxy", default="", help="proxy URL for prelogin, the config fetch, openconnect, and the tunnel")
        sp.add_argument("--certificate", default="", help="client certificate file (PEM/PKCS#12) for TLS client auth")
        sp.add_argument("--key", default="", help="client certificate key file, if separate")
        sp.add_argument("--ssl-only", dest="ssl_only", action="store_true", help="never use ESP over UDP (openconnect --no-dtls)")
        sp.add_argument("--mtu", type=int, default=0, help="tunnel MTU override (0 = let openconnect decide)")
        sp.add_argument("--block-lan", dest="block_lan", action="store_true", help="no direct access to the local network while connected")
        sp.add_argument("--dns-mode", dest="dns_mode", default="auto", choices=("auto", "split", "off"),
                        help="how the tunnel's DNS is applied to systemd-resolved: auto, split (pushed domains only), off")

    for name, fn, help_text in (
        ("status", cmd_status, "print the current state as JSON"),
        ("connect", cmd_connect, "sign in if needed and bring the tunnel up"),
        ("disconnect", cmd_disconnect, "bring the tunnel down"),
        ("login", cmd_login, "run only the sign-in window and store the session"),
        ("forget", cmd_forget, "drop the stored session and the sign-in window's saved logins"),
        ("deps", cmd_deps, "report which dependencies are installed"),
        ("hip-report", cmd_hip_report, "show what the HIP report says about this machine"),
        ("collect-logs", cmd_collect_logs, "write a scrubbed troubleshooting tarball (default: ~/Downloads)"),
        ("gateways", cmd_gateways, "list the portal's gateways (--refresh fetches, --probe measures latency)"),
        ("callback", cmd_callback, "internal: receive a globalprotectcallback: URI from the browser"),
        ("split-dns-rule", cmd_split_dns_rule, "print the polkit rule that lets the widget set the tunnel's DNS"),
        ("welcome", cmd_welcome, "the portal's welcome page (--show opens it in a window)"),
        ("hip-status", cmd_hip_status, "last HIP check/submission from openconnect's journal"),
    ):
        sp = sub.add_parser(name, help=help_text)
        common(sp)
        if name == "collect-logs":
            sp.add_argument("--output", default="", help="directory for the tarball")
        if name == "gateways":
            sp.add_argument("--refresh", action="store_true", help="sign in at the portal and fetch the gateway list")
            sp.add_argument("--probe", action="store_true", help="measure TLS latency to each gateway")
            sp.add_argument("--quiet", action="store_true", help="refresh only if it can be done without a sign-in window (exit 4 otherwise)")
        if name == "callback":
            sp.add_argument("uri", help="the globalprotectcallback: URI")
        if name == "welcome":
            sp.add_argument("--show", action="store_true", help="open the page in a window instead of printing it")
        if name == "forget":
            sp.add_argument("--remove", action="store_true", help="also remove the portal from the known list")
        sp.set_defaults(fn=fn)
    args = p.parse_args(argv)
    set_debug(args.debug or os.environ.get("OMARCHY_GP_DEBUG") == "1")
    set_options(args)
    debug_log(" ".join(a for a in (argv if argv is not None else sys.argv[1:]) if a != "--debug"))
    args.fn(args)


if __name__ == "__main__":
    main()
