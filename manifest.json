{
  "schemaVersion": 1,
  "id": "brianirish.globalprotect",
  "name": "GlobalProtect",
  "version": "1.0.3",
  "author": "Brian",
  "license": "MIT",
  "description": "GlobalProtect VPN with Google SSO: connect, watch, and manage the tunnel from the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "GlobalProtect",
    "description": "Connect to a GlobalProtect VPN through Google SSO. NetworkManager owns the tunnel.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "portal": "",
      "gateway": "",
      "clientOs": "win",
      "hipReport": false,
      "refreshIntervalSec": 5,
      "authInterface": "auto",
      "debug": false,
      "connectMethod": "on-demand",
      "pauseMinutes": 30,
      "samlBrowser": "embedded",
      "proxy": "",
      "certificate": "",
      "certificateKey": "",
      "dnsMode": "auto",
      "sslOnly": false,
      "mtu": 0,
      "blockLan": false,
      "followPortal": true
    },
    "schema": [
      {
        "key": "portal",
        "type": "string",
        "label": "Portal host"
      },
      {
        "key": "gateway",
        "type": "string",
        "label": "Gateway (optional)"
      },
      {
        "key": "authInterface",
        "type": "string",
        "label": "SAML sign-in interface (auto, gateway, portal)"
      },
      {
        "key": "clientOs",
        "type": "string",
        "label": "Reported client OS (win, linux, mac)"
      },
      {
        "key": "hipReport",
        "type": "boolean",
        "label": "Submit HIP report"
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 2,
        "max": 120,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "debug",
        "type": "boolean",
        "label": "Debug logging"
      },
      {
        "key": "connectMethod",
        "type": "string",
        "label": "Connect method (on-demand, always-on)"
      },
      {
        "key": "pauseMinutes",
        "type": "integer",
        "label": "Always-On pause (minutes)",
        "min": 1,
        "max": 1440,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "samlBrowser",
        "type": "string",
        "label": "SAML sign-in window (embedded, system)"
      },
      {
        "key": "proxy",
        "type": "string",
        "label": "Proxy URL (optional)"
      },
      {
        "key": "certificate",
        "type": "string",
        "label": "Client certificate file (optional)"
      },
      {
        "key": "certificateKey",
        "type": "string",
        "label": "Client certificate key file (optional)"
      },
      {
        "key": "dnsMode",
        "type": "string",
        "label": "Tunnel DNS (auto, split, off)"
      },
      {
        "key": "sslOnly",
        "type": "boolean",
        "label": "SSL only (no ESP over UDP)"
      },
      {
        "key": "mtu",
        "type": "integer",
        "label": "MTU override (0 = automatic)",
        "min": 0,
        "max": 9000,
        "step": 10,
        "defaultValue": 0
      },
      {
        "key": "blockLan",
        "type": "boolean",
        "label": "No direct access to local network"
      },
      {
        "key": "followPortal",
        "type": "boolean",
        "label": "Follow the portal's app settings"
      }
    ]
  }
}
